+    def _get_pnl_from_freqtrade_safe(self, current_time: datetime) -> tuple:
+        """Safe version for backtest and live trading."""
+        pnl_long = 0.0
+        pnl_short = 0.0
+        for trade in Trade.get_open_trades():
+            if self.config.get('runmode') == 'backtest':
+                # Fetch data limited to current_time to avoid lookahead
+                dataframe, _ = self.dp.get_analyzed_dataframe(
+                    trade.pair,
+                    self.timeframe,
+                    max_lines=100  # Limit to prevent lookahead
+                )
+                # Get the candle corresponding to current_time
+                candle = dataframe[dataframe['date'] <= current_time].iloc[-1]
+                profit_usdt = trade.calc_profit(rate=candle['close'])
+            else:
+                # Live trading logic
+                if trade.close_rate_requested:
+                    profit_usdt = trade.calc_profit(rate=trade.close_rate_requested)
+                else:
+                    dataframe, _ = self.dp.get_analyzed_dataframe(
+                        trade.pair,
+                        self.timeframe,
+                        max_lines=100
+                    )
+                    candle = dataframe[dataframe['date'] <= current_time].iloc[-1]
+                    profit_usdt = trade.calc_profit(rate=candle['close'])
+
+            # Accumulate profit based on trade side
+            if trade.side == 'long':
+                pnl_long += profit_usdt
+            else:
+                pnl_short += profit_usdt
+        return pnl_long, pnl_short
