+cfg.perf.cudnn_benchmark = True
+cfg.perf.cudnn_deterministic = None
+cfg.perf.num_threads = 4
+cfg.perf.non_blocking_transfer = True
+cfg.perf.use_amp = False           # set True для экономии VRAM, если нужно
+cfg.perf.amp_dtype = "float16"
+cfg.perf.compile_model = False     # set True для эксперимента с torch.compile
+cfg.perf.compile_mode = "reduce-overhead"
 
